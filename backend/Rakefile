# frozen_string_literal: true

# Rake is Ruby's task runner, like the "scripts" section of package.json.
#
#   bundle exec rake -T    lists the tasks below
#   bundle exec rake       runs the default task (check)

require 'rspec/core/rake_task'
require 'rubocop/rake_task'

desc 'Run every spec'
RSpec::Core::RakeTask.new(:spec)

namespace :spec do
  desc 'Run only the end-to-end spec for the sample files'
  RSpec::Core::RakeTask.new(:integration) do |task|
    task.pattern = 'spec/integration/**/*_spec.rb'
  end
end

desc 'Check code style with RuboCop'
RuboCop::RakeTask.new(:lint)

desc 'Run the style check, then every spec'
task check: %i[lint spec]

task default: :check
