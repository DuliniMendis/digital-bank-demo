#!/usr/bin/env ruby
# frozen_string_literal: true

# Loads account balances from one CSV file, applies the transfers in a
# second CSV file, and prints the final balances.
#
#   bin/process_transfers examples/account_balances.csv examples/transfers.csv

# Uses the gems and the Ruby version named in the Gemfile, wherever the
# command is run from.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'

require_relative '../lib/bank'

exit Bank::CLI.new.run(ARGV)
