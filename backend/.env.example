# Settings for running the API on your own machine. `bin/setup` copies this
# file to `.env`, which is never committed. The server and the seed command
# read that copy when they start.

# The address of the Postgres database. This one is a database called
# bank_development, on a Postgres server running on this machine.
DATABASE_URL=postgres://localhost/bank_development

# The balances file that seeding and the reset route load. Remove the # and
# name your own file to use it in place of the sample balances.
# BALANCES_FILE=path/to/balances.csv
