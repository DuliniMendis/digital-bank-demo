# frozen_string_literal: true

source 'https://rubygems.org'

# Any Ruby from 3.3 onwards will do, because that is the oldest version the
# gems in Gemfile.lock support. The version used for development is in
# `.ruby-version`.
ruby '>= 3.3'

# CSV parsing used to be part of Ruby itself. Since Ruby 3.4 it is a
# separate gem that has to be listed here.
gem 'csv'

# dotenv reads the settings in a `.env` file into the environment when the
# app starts. It never replaces a setting that is already there, and it does
# nothing when there is no `.env` file, as on the hosted version.
gem 'dotenv'

# pg is the Postgres driver. Sequel sits on top of it and lets the code
# describe queries in Ruby instead of writing SQL strings.
gem 'pg'
gem 'sequel'

# Sinatra is the web framework, Puma is the server it runs on, and rackup
# provides the command that starts it.
gem 'puma'
gem 'rackup'
gem 'sinatra'

group :development, :test do
  gem 'rack-test'
  gem 'rspec', '~> 3.13'
  gem 'rubocop', require: false
  gem 'rubocop-rspec', require: false
end
