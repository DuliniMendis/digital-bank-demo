# frozen_string_literal: true

source 'https://rubygems.org'

ruby file: '.ruby-version'

# Reads CSV files. It stopped being built into Ruby in version 3.4.
gem 'csv'

# Sinatra is a small web framework. Puma is the server that runs it, and
# rackup provides the `rackup` command that starts it.
gem 'puma'
gem 'rackup'
gem 'sinatra'

group :development, :test do
  gem 'rack-test'
  gem 'rspec', '~> 3.13'
  gem 'rubocop', require: false
  gem 'rubocop-rspec', require: false
end
